    },
    "VerifyAnkiImportRequest": {
      "type": "object",
      "properties": {
        "export_result": { "$ref": "#/$defs/ExportResult" },
        "deck_name": { "type": "string" },
        "deck_kind": { "type": "string" },
        "apkg_path": { "type": "string" },
        "media_dir": { "type": "string" },
        "anki_tag": { "type": "string" },
        "anki_query": { "type": "string" },
        "anki_connect_url": { "type": "string" },
        "prepare_media_only": { "type": "boolean" },
        "import_apkg": { "type": "boolean" }
      },
      "oneOf": [
        {
          "required": ["export_result"],
          "not": { "required": ["anki_query"] }
        },
        {
          "required": ["anki_query"],
          "not": {
            "anyOf": [
              { "required": ["export_result"] },
              { "required": ["import_apkg"] },
              { "required": ["prepare_media_only"] }
            ]
          }
        }
      ],
      "additionalProperties": true
    },
