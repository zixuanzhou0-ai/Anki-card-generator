{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anki-card-generator.local/contracts/worker-command-contract.v1.schema.json",
  "title": "Anki Card Generator worker command contract fixtures v1",
  "description": "Versioned, machine-readable contract for the nine public Python worker commands. The schema validates the representative exchanges in the golden fixture; x-acg-contract documents the literal wire transport.",
  "type": "array",
  "minItems": 9,
  "maxItems": 9,
  "items": {
    "oneOf": [
      { "$ref": "#/$defs/CheckEnvExchange" },
      { "$ref": "#/$defs/RepairEnvExchange" },
      { "$ref": "#/$defs/TestApiExchange" },
      { "$ref": "#/$defs/TestTtsExchange" },
      { "$ref": "#/$defs/ExtractLearningPointsExchange" },
      { "$ref": "#/$defs/GenerateCardsFromLearningPointsExchange" },
      { "$ref": "#/$defs/GenerateExchange" },
      { "$ref": "#/$defs/ExportExchange" },
      { "$ref": "#/$defs/VerifyAnkiImportExchange" }
    ]
  },
  "x-acg-contract": {
    "contract_version": "1.0.0",
    "worker_schema_version": 2,
    "status": "frozen-baseline",
    "compatibility_policy": {
      "additive_optional_fields": "compatible",
      "new_progress_stage": "requires contract review",
      "remove_required_field": "breaking",
      "change_required_field_type": "breaking",
      "error_code_set": "open; consumers must tolerate unknown non-empty codes"
    },
    "transport": {
      "command": "argv[1]",
      "request": "one JSON object on stdin; UTF-8 BOM is tolerated; empty stdin becomes {}",
      "result": "one JSON value on stdout; object results receive schema_version=2 when absent",
      "progress": "one JSON object per stderr line prefixed by __ANKI_CARD_PROGRESS__; every progress frame has schema_version=2",
      "error": "one JSON object prefixed by __ANKI_CARD_ERROR__ on stderr, followed by a plain message line and non-zero exit"
    },
    "progress_stages": {
      "check_env": [],
      "repair_env": ["start", "venv", "pip", "python_packages", "ffmpeg", "js_runtime", "anki", "done"],
      "test_api": [],
      "test_tts": [],
      "extract_learning_points": ["source", "download", "subtitle", "sentences", "local_recall", "ai_review", "classify", "done"],
      "generate_cards_from_learning_points": ["source", "ai", "cards", "done"],
      "generate": ["source", "download", "subtitle", "segments", "document", "batch", "context", "learning_point_expansion", "phrase_review", "ai", "cards", "done"],
      "export": ["prepare", "template", "tts", "notes", "media", "package", "done"],
      "verify_anki_import": ["prepare_media", "restore_media", "import_preflight", "import", "query"]
    },
    "progress_emitting_commands": [
      "repair_env",
      "extract_learning_points",
      "generate_cards_from_learning_points",
      "generate",
      "export",
      "verify_anki_import"
    ],
    "sensitive_request_paths": [
      "api_config.api_key",
      "tts_config.api_key",
      "api_config.tts_config.api_key"
    ],
    "sensitive_result_passthrough_paths": [],
    "result_secret_policy": "runtime secret keys are recursively blanked before a Project result leaves the worker",

    "core_error_codes": [
      "ANKI_EXPORT_FAILED",
      "ANKI_VERIFY_FAILED",
      "ENV_FFMPEG_MISSING",
      "ENV_PYTHON_MISSING",
      "EXPORT_QUALITY_GATE_FAILED",
      "FFMPEG_SLICE_FAILED",
      "MEDIA_SUBTITLE_ALIGNMENT_MISMATCH",
      "MODEL_AUTH_FAILED",
      "MODEL_CONNECTION_FAILED",
      "MODEL_JSON_INVALID",
      "MODEL_NOT_FOUND",
      "MODEL_QUOTA_EXCEEDED",
      "MODEL_TIMEOUT",
      "TTS_AUTH_FAILED",
      "TTS_CONNECTION_FAILED",
      "TTS_NOT_FOUND",
      "TTS_QUOTA_EXCEEDED",
      "TTS_TIMEOUT",
      "UNKNOWN_WORKER_ERROR",
      "WORKER_CANCELLED",
      "WORKER_TIMEOUT",
      "YOUTUBE_N_CHALLENGE",
      "YOUTUBE_RATE_LIMIT",
      "YOUTUBE_SUBTITLE_UNAVAILABLE"
    ]
  },
  "$defs": {
    "NonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "TagString": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S+$"
    },
    "StringArray": {
      "type": "array",
      "items": { "type": "string" }
    },
    "StringMap": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "TimingMap": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "ApiConfig": {
      "type": "object",
      "properties": {
        "provider": { "type": "string" },
        "base_url": { "type": "string" },
        "model": { "type": "string" },
        "api_key": { "type": "string", "writeOnly": true, "x-sensitive": true },
        "auth_mode": { "type": "string" },
        "tts_config": { "$ref": "#/$defs/TtsConfig" }
      },
      "additionalProperties": true
    },
    "TtsConfig": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "provider": { "type": "string" },
        "base_url": { "type": "string" },
        "model": { "type": "string" },
        "voice": { "type": "string" },
        "language": { "type": "string" },
        "sample_rate": { "type": "integer", "minimum": 1 },
        "bit_rate": { "type": "integer", "minimum": 1 },
        "output_volume": { "type": "number", "minimum": 0, "maximum": 1 },
        "api_key": { "type": "string", "writeOnly": true, "x-sensitive": true }
      },
      "additionalProperties": true
    },
    "WorkerProgress": {
      "type": "object",
      "required": ["schema_version", "command", "stage", "percent", "message"],
      "properties": {
        "schema_version": { "const": 2 },
        "command": {
          "enum": [
            "check_env",
            "repair_env",
            "test_api",
            "test_tts",
            "extract_learning_points",
            "generate_cards_from_learning_points",
            "generate",
            "export",
            "verify_anki_import"
          ]
        },
        "stage": { "$ref": "#/$defs/NonEmptyString" },
        "percent": { "type": "integer", "minimum": 0, "maximum": 100 },
        "message": { "type": "string" },
        "completed_batches": { "type": "integer", "minimum": 0 },
        "total_batches": { "type": "integer", "minimum": 0 },
        "cache_hits": { "type": "integer", "minimum": 0 },
        "cache_misses": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "WorkerError": {
      "type": "object",
      "required": ["schema_version", "message", "retryable", "fallbacks"],
      "properties": {
        "schema_version": { "const": 2 },
        "message": { "$ref": "#/$defs/NonEmptyString" },
        "error_code": { "$ref": "#/$defs/NonEmptyString" },
        "stage": { "$ref": "#/$defs/NonEmptyString" },
        "retryable": { "type": "boolean" },
        "fallbacks": { "$ref": "#/$defs/StringArray" },
        "details": { "type": "object", "additionalProperties": true }
      },
      "additionalProperties": true
    },
    "StatusItem": {
      "type": "object",
      "required": ["id", "label", "status", "detail"],
      "properties": {
        "id": { "$ref": "#/$defs/NonEmptyString" },
        "label": { "$ref": "#/$defs/NonEmptyString" },
        "status": { "enum": ["ok", "action", "blocked"] },
        "detail": { "type": "string" },
        "fix": { "type": "string" }
      },
      "additionalProperties": true
    },
    "RepairAction": {
      "type": "object",
      "required": ["id", "label", "status", "detail"],
      "properties": {
        "id": { "$ref": "#/$defs/NonEmptyString" },
        "label": { "$ref": "#/$defs/NonEmptyString" },
        "status": { "enum": ["success", "failed", "skipped", "manual"] },
        "detail": { "type": "string" },
        "command": { "type": "string" },
        "next_step": { "type": "string" }
      },
      "additionalProperties": true
    },
    "LearningPoint": {
      "type": "object",
      "required": ["id", "status"],
      "properties": {
        "id": { "$ref": "#/$defs/NonEmptyString" },
        "status": { "enum": ["recommended", "candidate_only", "hidden_duplicate", "hard_blocked"] },
        "answer_core": { "type": "string" },
        "exact_span": { "type": "string" },
        "source_sentence": { "type": "string" },
        "start": { "type": "number", "minimum": 0 },
        "end": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "Segment": {
      "type": "object",
      "required": ["id", "cards"],
      "properties": {
        "id": { "$ref": "#/$defs/NonEmptyString" },
        "start": { "type": "number", "minimum": 0 },
        "end": { "type": "number", "minimum": 0 },
        "text": { "type": "string" },
        "cards": { "type": "array", "items": { "type": "object", "additionalProperties": true } }
      },
      "additionalProperties": true
    },
    "SelectedPointOutcome": {
      "type": "object",
      "required": ["learning_point_id", "status", "blocker_codes"],
      "properties": {
        "learning_point_id": { "$ref": "#/$defs/NonEmptyString" },
        "status": { "enum": ["verified", "needs_review", "hard_failed"] },
        "card_id": { "type": "string" },
        "blocker_codes": { "$ref": "#/$defs/StringArray" },
        "reason": { "type": "string" }
      },
      "additionalProperties": true
    },
    "ReliabilityManifest": {
      "type": "object",
      "required": [
        "schema_version",
        "verification_profile",
        "decision",
        "accounting_complete",
        "selected_point_count",
        "verified_count",
        "needs_review_count",
        "hard_failed_count",
        "selected_point_outcomes",
        "blocker_codes",
        "created_at"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "verification_profile": { "$ref": "#/$defs/NonEmptyString" },
        "decision": { "enum": ["pass", "block", "partial_requires_confirmation"] },
        "accounting_complete": { "type": "boolean" },
        "selected_point_count": { "type": "integer", "minimum": 0 },
        "verified_count": { "type": "integer", "minimum": 0 },
        "needs_review_count": { "type": "integer", "minimum": 0 },
        "hard_failed_count": { "type": "integer", "minimum": 0 },
        "selected_point_outcomes": { "type": "array", "items": { "$ref": "#/$defs/SelectedPointOutcome" } },
        "blocker_codes": { "$ref": "#/$defs/StringArray" },
        "source_fingerprint": { "type": "string" },
        "model_provider": { "type": "string" },
        "model_name": { "type": "string" },
        "created_at": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "CheckEnvRequest": {
      "type": "object",
      "additionalProperties": true
    },
    "CheckEnvResult": {
      "type": "object",
      "required": [
        "schema_version",
        "python",
        "python_executable",
        "venv",
        "ffmpeg",
        "genanki",
        "yt_dlp",
        "anki_installed",
        "anki_running",
        "anki_connect",
        "packages",
        "status_items",
        "worker"
      ],
      "properties": {
        "schema_version": { "const": 2 },
        "python": { "$ref": "#/$defs/NonEmptyString" },
        "python_executable": { "$ref": "#/$defs/NonEmptyString" },
        "venv": { "type": "boolean" },
        "ffmpeg": { "type": "boolean" },
        "ffmpeg_path": { "type": "string" },
        "ffmpeg_version": { "type": "string" },
        "genanki": { "type": "boolean" },
        "yt_dlp": { "type": "boolean" },
        "yt_dlp_version": { "type": "string" },
        "yt_dlp_js_runtime": { "type": "string" },
        "anki_installed": { "type": "boolean" },
        "anki_path": { "type": "string" },
        "anki_running": { "type": "boolean" },
        "anki_connect": { "type": "boolean" },
        "anki_connect_detail": { "type": "string" },
        "packages": { "$ref": "#/$defs/StringMap" },
        "status_items": { "type": "array", "items": { "$ref": "#/$defs/StatusItem" } },
        "worker": { "$ref": "#/$defs/NonEmptyString" }
      },
      "additionalProperties": true
    },
    "RepairEnvRequest": {
      "type": "object",
      "properties": {
        "target": {
          "type": "string",
          "default": "auto",
          "x-normalized-values": ["all", "auto", "python_packages", "ffmpeg", "js_runtime", "anki", "anki_connect"],
          "x-unknown-value-behavior": "normalized to auto"
        }
      },
      "additionalProperties": true
    },
    "RepairEnvResult": {
      "type": "object",
      "required": ["schema_version", "ok", "target", "summary", "actions"],
      "properties": {
        "schema_version": { "const": 2 },
        "ok": { "type": "boolean" },
        "target": { "enum": ["all", "auto", "python_packages", "ffmpeg", "js_runtime", "anki", "anki_connect"] },
        "summary": { "type": "string" },
        "actions": { "type": "array", "items": { "$ref": "#/$defs/RepairAction" } }
      },
      "additionalProperties": true
    },
    "TestApiRequest": {
      "type": "object",
      "properties": {
        "api_config": { "$ref": "#/$defs/ApiConfig" }
      },
      "additionalProperties": true
    },
    "TestApiResult": {
      "type": "object",
      "required": ["schema_version", "ok", "provider", "model", "message"],
      "properties": {
        "schema_version": { "const": 2 },
        "ok": { "type": "boolean" },
        "provider": { "type": "string" },
        "model": { "type": "string" },
        "message": { "type": "string" },
        "error_code": { "type": "string" },
        "stage": { "type": "string" },
        "retryable": { "type": "boolean" },
        "latency_ms": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "TestTtsRequest": {
      "type": "object",
      "properties": {
        "tts_config": { "$ref": "#/$defs/TtsConfig" },
        "api_config": { "$ref": "#/$defs/ApiConfig" },
        "language": { "type": "string" }
      },
      "additionalProperties": true
    },
    "TestTtsResult": {
      "type": "object",
      "required": ["schema_version", "ok", "provider", "model", "voice", "message"],
      "properties": {
        "schema_version": { "const": 2 },
        "ok": { "type": "boolean" },
        "provider": { "type": "string" },
        "model": { "type": "string" },
        "voice": { "type": "string" },
        "message": { "type": "string" },
        "error_code": { "type": "string" },
        "stage": { "type": "string" },
        "retryable": { "type": "boolean" },
        "latency_ms": { "type": "integer", "minimum": 0 },
        "bytes": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "ExtractLearningPointsRequest": {
      "type": "object",
      "properties": {
        "source_mode": { "enum": ["local", "url"] },
        "source_url": { "type": "string" },
        "video_path": { "type": "string" },
        "subtitle_path": { "type": "string" },
        "language": { "type": "string" },
        "level_mode": { "type": "string" },
        "level": { "type": "string" },
        "api_config": { "$ref": "#/$defs/ApiConfig" }
      },
      "anyOf": [
        { "required": ["source_url"] },
        { "required": ["video_path"] },
        { "required": ["subtitle_path"] }
      ],
      "additionalProperties": true
    },
    "ExtractLearningPointsResult": {
      "type": "object",
      "required": [
        "schema_version",
        "id",
        "title",
        "source_mode",
        "video_path",
        "subtitle_path",
        "language",
        "level_mode",
        "level",
        "review_basis",
        "source_sentences",
        "learning_points",
        "learning_point_summary",
        "timing_ms",
        "quality_funnel",
        "ai_model_errors",
        "warnings"
      ],
      "properties": {
        "schema_version": { "const": 2 },
        "id": { "$ref": "#/$defs/NonEmptyString" },
        "title": { "$ref": "#/$defs/NonEmptyString" },
        "source_mode": { "type": "string" },
        "video_path": { "type": "string" },
        "subtitle_path": { "type": "string" },
        "language": { "type": "string" },
        "level_mode": { "type": "string" },
        "level": { "type": "string" },
        "review_basis": { "const": "ai_reviewed" },
        "source_sentences": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
        "learning_points": { "type": "array", "items": { "$ref": "#/$defs/LearningPoint" } },
        "learning_point_summary": { "type": "object", "additionalProperties": true },
        "timing_ms": { "$ref": "#/$defs/TimingMap" },
        "quality_funnel": { "type": "object", "additionalProperties": true },
        "ai_model_errors": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
        "warnings": { "$ref": "#/$defs/StringArray" }
      },
      "additionalProperties": true
    },
    "GenerateCardsFromLearningPointsRequest": {
      "type": "object",
      "required": ["learning_points"],
      "properties": {
        "project_id": { "type": "string" },
        "title": { "type": "string" },
        "source_mode": { "type": "string" },
        "video_path": { "type": "string" },
        "subtitle_path": { "type": "string" },
        "language": { "type": "string" },
        "level": { "type": "string" },
        "learning_points": { "type": "array", "items": { "$ref": "#/$defs/LearningPoint" } },
        "selected_learning_point_ids": { "$ref": "#/$defs/StringArray" },
        "existing_project": { "type": "object", "additionalProperties": true },
        "existing_generated_ids": { "$ref": "#/$defs/StringArray" },
        "api_config": { "$ref": "#/$defs/ApiConfig" },
        "tts_config": { "$ref": "#/$defs/TtsConfig" }
      },
      "additionalProperties": true
    },
    "GenerateCardsFromLearningPointsResult": {
      "type": "object",
      "required": [
        "schema_version",
        "id",
        "title",
        "source_mode",
        "language",
        "level",
        "template_id",
        "quality_funnel",
        "card_generation_diagnostics",
        "reliability_manifest",
        "generated_learning_point_ids",
        "source_fingerprint",
        "segments"
      ],
      "properties": {
        "schema_version": { "const": 2 },
        "id": { "$ref": "#/$defs/NonEmptyString" },
        "title": { "$ref": "#/$defs/NonEmptyString" },
        "source_mode": { "type": "string" },
        "language": { "type": "string" },
        "level": { "type": "string" },
        "template_id": { "type": "string" },
        "quality_funnel": { "type": "object", "additionalProperties": true },
        "card_generation_diagnostics": { "type": "object", "additionalProperties": true },
        "reliability_manifest": { "$ref": "#/$defs/ReliabilityManifest" },
        "generated_learning_point_ids": { "$ref": "#/$defs/StringArray" },
        "source_fingerprint": { "type": "string" },
        "segments": { "type": "array", "items": { "$ref": "#/$defs/Segment" } },
        "created_at": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "GenerateRequest": {
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "source_mode": { "type": "string" },
        "source_url": { "type": "string" },
        "video_path": { "type": "string" },
        "subtitle_path": { "type": "string" },
        "document_path": { "type": "string" },
        "batch_enabled": { "type": "boolean" },
        "batch_items": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
        "language": { "type": "string" },
        "level": { "type": "string" },
        "api_config": { "$ref": "#/$defs/ApiConfig" }
      },
      "anyOf": [
        { "required": ["source_url"] },
        { "required": ["video_path"] },
        { "required": ["subtitle_path"] },
        { "required": ["document_path"] },
        { "required": ["batch_items"] }
      ],
      "additionalProperties": true
    },
    "GenerateResult": {
      "type": "object",
      "required": [
        "schema_version",
        "id",
        "title",
        "source_mode",
        "language",
        "level",
        "template_id",
        "quality_funnel",
        "segments",
        "created_at"
      ],
      "properties": {
        "schema_version": { "const": 2 },
        "id": { "$ref": "#/$defs/NonEmptyString" },
        "title": { "$ref": "#/$defs/NonEmptyString" },
        "source_mode": { "type": "string" },
        "language": { "type": "string" },
        "level": { "type": "string" },
        "template_id": { "type": "string" },
        "quality_funnel": { "type": "object", "additionalProperties": true },
        "segments": { "type": "array", "items": { "$ref": "#/$defs/Segment" } },
        "warning": { "type": ["string", "null"] },
        "created_at": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "ExportRequest": {
      "type": "object",
      "required": ["project", "output_dir"],
      "properties": {
        "project": { "type": "object", "additionalProperties": true },
        "output_dir": { "$ref": "#/$defs/NonEmptyString" },
        "canonical_apkg_path": { "type": "string" }
      },
      "additionalProperties": true
    },
    "Sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "ExportMediaManifestEntry": {
      "type": "object",
      "required": ["sha256", "bytes"],
      "properties": {
        "sha256": { "$ref": "#/$defs/Sha256" },
        "bytes": { "type": "integer", "minimum": 0 },
        "role": { "type": "string" },
        "segment_id": { "type": "string" },
        "card_id": { "type": "string" },
        "learning_point_id": { "type": "string" },
        "field": { "type": "string" },
        "source_time": { "type": "string" },
        "tts_text": { "type": "string" },
        "text_hash": { "type": "string" },
        "semantic_verification": { "type": "string" },
        "manual_review_required": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "ExportMediaLedgerItem": {
      "type": "object",
      "required": ["file", "role", "segment_id", "card_id", "field"],
      "properties": {
        "file": { "$ref": "#/$defs/NonEmptyString" },
        "role": { "$ref": "#/$defs/NonEmptyString" },
        "segment_id": { "$ref": "#/$defs/NonEmptyString" },
        "card_id": { "type": "string" },
        "learning_point_id": { "type": "string" },
        "field": { "$ref": "#/$defs/NonEmptyString" },
        "source_time": { "type": "string" },
        "tts_text": { "type": "string" },
        "text_hash": { "type": "string" }
      },
      "additionalProperties": true
    },
    "ExportCardMediaLedgerItem": {
      "type": "object",
      "required": ["card_id", "segment_id", "deck_name", "note_tags", "note_content_sha256"],
      "properties": {
        "card_id": { "$ref": "#/$defs/NonEmptyString" },
        "segment_id": { "$ref": "#/$defs/NonEmptyString" },
        "deck_name": { "$ref": "#/$defs/NonEmptyString" },
        "note_tags": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/TagString" }
        },
        "note_content_sha256": { "$ref": "#/$defs/Sha256" },
        "source_card_id": { "type": "string" },
        "learning_point_id": { "type": "string" },
        "source_time": { "type": "string" }
      },
      "additionalProperties": true
    },
    "NoteContentFingerprint": {
      "type": "object",
      "required": ["schema_version", "algorithm", "serialization", "field_names", "card_count"],
      "properties": {
        "schema_version": { "const": 1 },
        "algorithm": { "const": "sha256" },
        "serialization": { "const": "json-field-pairs-v1" },
        "field_names": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^\\S(?:.*\\S)?$"
          }
        },
        "card_count": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
