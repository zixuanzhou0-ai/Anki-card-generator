      "type": "object",
      "required": [
        "schema_version",
        "ok",
        "message",
        "failed_checks",
        "query",
        "import_attempted",
        "import_result",
        "import_skipped_existing",
        "timing_ms"
      ],
      "properties": {
        "schema_version": { "const": 2 },
        "ok": { "type": "boolean" },
        "message": { "type": "string" },
        "failed_checks": { "$ref": "#/$defs/StringArray" },
        "query": { "type": "string" },
        "import_attempted": { "type": "boolean" },
        "import_result": {},
        "import_skipped_existing": { "type": "boolean" },
        "timing_ms": { "$ref": "#/$defs/TimingMap" }
      },
      "additionalProperties": true
    },
