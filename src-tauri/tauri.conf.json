{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Anki Card Generator",
  "version": "0.9.8",
  "identifier": "com.ankicard.generator",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Anki 卡片生成器",
        "url": "/",
        "visible": true,
        "width": 1540,
        "height": 1080,
        "minWidth": 1180,
        "minHeight": 780,
        "resizable": true,
        "decorations": false,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src \u0027self\u0027 asset: http://asset.localhost; img-src \u0027self\u0027 asset: http://asset.localhost data: blob:; media-src \u0027self\u0027 asset: http://asset.localhost data: blob:; style-src \u0027self\u0027 \u0027unsafe-inline\u0027; script-src \u0027self\u0027; connect-src \u0027self\u0027 ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../workers/anki_worker.py": "workers/anki_worker.py",
      "../workers/acg": "workers/acg",
      "../workers/requirements.txt": "workers/requirements.txt",
      "../workers/verify_apkg.py": "workers/verify_apkg.py"
    },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
